{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["infra/**/*.ts", "packages/**/*.ts", "services/**/*.ts", "gateway/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
