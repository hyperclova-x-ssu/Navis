# Single source for the edge nginx config. Rendered by the nginx image entrypoint (envsubst on /etc/nginx/templates) when mounted there,
# and kept rendered with the Compose values in nginx.conf (checked byte-for-byte by deploy/scripts/validate.sh).
# Variables substituted: NGINX_LOCAL_RESOLVERS (exported by the nginx image from /etc/resolv.conf: Docker 127.0.0.11, NKS the kube-dns ClusterIP;
# nginx `resolver` needs an IP), NAVIS_EDGE_FRONTEND_UPSTREAM, NAVIS_EDGE_GATEWAY_UPSTREAM, NAVIS_EDGE_AUTH_BASIC, NAVIS_EDGE_AUTH_FILE, NAVIS_EDGE_GATE, NAVIS_EDGE_ORIGIN_CHECK.
# Demo password gate (D-336, W5-APIGATE): NAVIS_EDGE_AUTH_BASIC is `off` (Compose, no password) or a realm without spaces such as `Navis-demo` (NKS, htpasswd from
# Secret navis-edge-auth mounted at NAVIS_EDGE_AUTH_FILE). nginx only opens the file when auth is on, so Compose needs no file.
# Basic auth gates the screen (location /). /api cannot use it (the app sends its own `Authorization: Bearer` there), so /api is gated by a
# cookie instead: a successful basic-auth page load makes `location /` send Set-Cookie navis_gate=<token> (HttpOnly; Secure; SameSite=Strict;
# Max-Age 7 days), and every /api request without that cookie gets 401. /healthz and /readyz (probes) stay open. The token is a random value from
# Secret navis-edge-auth (files gate-ok.conf = map body `"<token>" 1;`, gate-cookie.conf = map body `default "<Set-Cookie value>";`, made by
# apply.sh edge-auth-secret from ~/.navis-ncp/secrets/edge_gate_token). NAVIS_EDGE_GATE is `on` (NKS) or `off` (Compose: no files, no cookie, no check);
# any other value denies /api (fail closed), and so does `on` with the token files missing.
# Trade-off: nginx has no constant-time compare (a `map` lookup is a hash lookup, not a timing-safe string compare). With a 256-bit random token,
# network jitter and Funnel in front, a timing attack is not practical; the token is also revoked by rotating the file (set-demo-password.sh).
# The cookie is forwarded in-cluster with the rest of the Cookie header. Upstreams ignore the gate cookie.
# Compose uses frontend:80 and api-gateway:3000. NKS uses their fully qualified names in the navis namespace. Everything under /api/ goes to api-gateway
# (D-339: Navis chat and promo are served behind the gateway; there is no separate navis upstream).
# Origin protection (W5-GE, D-338): the public path is NCP Global Edge -> public ALB -> this nginx, and the CDN->ALB leg is plain HTTP. Global Edge adds the
# origin request header X-Navis-Origin-Key (HeaderPolicy ORIGIN_REQUEST, value from ~/.navis-ncp/secrets/edge_origin_key). NAVIS_EDGE_ORIGIN_CHECK is `on`
# (NKS) or `off` (Compose). With `on`, every request without the right header gets 403, except /healthz and /readyz (ALB and kubelet probes cannot send it).
# The accepted value comes from Secret navis-edge-auth file origin-ok.conf (map body `"<key>" 1;`); `on` with the file missing denies everything but the
# probes, and any other mode value denies too (fail closed). Same timing-attack note as the gate token: a map lookup is not constant-time, the key is 256-bit.
# Moa device path (D-339): POST /api/v1/insight/cctv/aggregates is not behind the demo password or the gate cookie, because the device has neither; the device
# bearer token is checked by api-gateway. It still needs the origin key when the check is on, so it is reachable only through Global Edge.
# The 64-char token key does not fit the default 64-byte map bucket.
map_hash_bucket_size 128;

# $navis_gate_token_ok: 1 when the request carries the right gate cookie. The include may match no file (Compose): then the map has only `default 0`.
map $cookie_navis_gate $navis_gate_token_ok {
    default 0;
    include /etc/nginx/auth/gate-ok*.conf;
}

# $navis_gate_deny: 1 = refuse /api. Compose `off` never refuses; `on` refuses unless the cookie matched; anything else refuses.
map "${NAVIS_EDGE_GATE}:$navis_gate_token_ok" $navis_gate_deny {
    default 1;
    "off:0" 0;
    "off:1" 0;
    "on:1" 0;
}

# This proof stays on the private edge-to-gateway hop. An absent include, a
# disabled password/cookie gate or an unverified cookie leaves it empty.
map $server_name $navis_edge_demo_key {
    include /etc/nginx/demo-auth/gate-proof*.conf;
}

map "${NAVIS_EDGE_GATE}:${NAVIS_EDGE_AUTH_BASIC}:$navis_gate_token_ok:$request_method:$uri" $navis_edge_demo_proof {
    default "";
    "~^on:(?!off:)[^:]+:1:POST:/api/v1/auth/demo$" $navis_edge_demo_key;
}

# $navis_gate_cookie: the Set-Cookie value, empty (header omitted) when no gate-cookie file is mounted.
map $server_name $navis_gate_cookie {
    # no `default` here: gate-cookie.conf supplies it; with no file the value is empty and add_header skips it
    include /etc/nginx/auth/gate-cookie*.conf;
}

# $navis_origin_key_ok: 1 when X-Navis-Origin-Key matches. The include may match no file (Compose): then the map has only `default 0`.
map $http_x_navis_origin_key $navis_origin_key_ok {
    default 0;
    include /etc/nginx/auth/origin-ok*.conf;
}

# $navis_origin_deny: 1 = refuse with 403. `off` never refuses; `on` refuses unless the key matched, probes excepted; anything else refuses.
map "${NAVIS_EDGE_ORIGIN_CHECK}:$navis_origin_key_ok:$uri" $navis_origin_deny {
    default 1;
    "~^off:" 0;
    "~^on:1:" 0;
    "~^on:0:/(healthz|readyz)$" 0;
}

# Global Edge supplies True-Client-IP on the origin-key-protected hop.
# Compose has no trusted forwarding hop and uses the connection address.
map "${NAVIS_EDGE_ORIGIN_CHECK}" $navis_talktalk_client_ip {
    default "";
    on $http_true_client_ip;
    off $remote_addr;
}

geo $navis_talktalk_client_ip $navis_talktalk_source_allowed {
    default 0;
    211.249.40.0/27 1;
    211.249.68.0/27 1;
    220.230.168.0/27 1;
    103.6.173.0/27 1;
}

map "${NAVIS_EDGE_ORIGIN_CHECK}" $navis_talktalk_upstream {
    default marketing.navis.svc.cluster.local:3000;
    off marketing:3000;
}

limit_req_zone $navis_talktalk_client_ip zone=talktalk_webhook:1m rate=60r/m;

log_format navis_edge escape=json
  '{"service":"edge","requestId":"$request_id","method":"$request_method","status":$status,"upstream":"$upstream_addr"}';

resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;

upstream frontend_upstream {
    zone frontend_upstream 64k;
    server ${NAVIS_EDGE_FRONTEND_UPSTREAM} resolve;
}

upstream gateway_upstream {
    zone gateway_upstream 64k;
    server ${NAVIS_EDGE_GATEWAY_UPSTREAM} resolve;
}

server {
    listen 80;
    server_tokens off;
    access_log /dev/stdout navis_edge;
    error_log /dev/stderr crit;
    proxy_http_version 1.1;
    proxy_hide_header X-Request-Id;
    add_header X-Request-Id $request_id always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    auth_basic ${NAVIS_EDGE_AUTH_BASIC};
    auth_basic_user_file ${NAVIS_EDGE_AUTH_FILE};

    # Origin protection: runs in the rewrite phase, before any location (see the header comment).
    if ($navis_origin_deny) {
        return 403 '{"error":"edge_origin"}';
    }

    location = /healthz {
        auth_basic off;
        default_type application/json;
        return 200 '{"service":"edge","status":"ok"}';
    }

    location = /readyz {
        auth_basic off;
        proxy_pass http://gateway_upstream/readyz;
        proxy_pass_request_headers off;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
    }

    # D-378: the origin check still runs; marketing authenticates the secret path.
    location ~ "^/hooks/talktalk/[A-Za-z0-9_-]{1,128}$" {
        auth_basic off;
        access_log off;
        error_log /dev/null;
        if ($navis_talktalk_source_allowed = 0) { return 403; }
        if ($request_method != POST) { return 405; }
        limit_req zone=talktalk_webhook burst=12 nodelay;
        limit_req_status 429;
        client_max_body_size 32k;
        proxy_connect_timeout 1s;
        proxy_read_timeout 4s;
        proxy_next_upstream off;
        proxy_pass http://$navis_talktalk_upstream$uri;
        proxy_pass_request_headers off;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
    }

    # Moa device ingest (D-339): no demo password, no gate cookie. api-gateway validates the device bearer token. POST only.
    location = /api/v1/insight/cctv/aggregates {
        auth_basic off;
        default_type application/json;
        limit_except POST { deny all; }
        include /etc/nginx/navis-api-proxy.inc;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
    }

    location = /api {
        auth_basic off;
        default_type application/json;
        if ($navis_gate_deny) {
            return 401 '{"error":"edge_gate"}';
        }
        include /etc/nginx/navis-api-proxy.inc;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
    }

    location ^~ /api/ {
        auth_basic off;
        default_type application/json;
        if ($navis_gate_deny) {
            return 401 '{"error":"edge_gate"}';
        }
        include /etc/nginx/navis-api-proxy.inc;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
    }

    location / {
        # add_header here replaces the server-level ones, so they are repeated. Only this location sets the gate cookie: it is behind basic auth.
        add_header Set-Cookie $navis_gate_cookie;
        add_header X-Request-Id $request_id always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_pass http://frontend_upstream;
        proxy_pass_request_headers off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
    }
}
